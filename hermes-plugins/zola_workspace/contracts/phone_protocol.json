      "secret": false
    },
    "read_history": {
      "secret": true
    },
    "read_notifications": {
      "secret": true
    },
    "read_code": {
      "secret": true
    },
    "diagnostic_read": {
      "secret": true
    },
    "pairing.start": {
      "secret": true
    }
  },
  "secret_failure": "unauthorized",
  "link_states": [
    "not_paired",
    "connected",
    "not_responding",
    "reconnecting",
    "offline",
    "no_tailnet"
  ],
  "wire": {
    "encoding": "utf-8-json",
    "fields": [
      "magic",
      "kind",
      "signature",
      "payload"
    ],
    "signature_covers": "canonical payload"
