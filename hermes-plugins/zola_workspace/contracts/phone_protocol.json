      "reason": "unknown-key"
    },
    {
      "step": "wrong-device",
      "reason": "wrong-device"
    },
    {
      "step": "replay",
      "reason": "replay"
    },
    {
      "step": "stale",
      "reason": "stale"
    },
    {
      "step": "version",
      "reason": "version"
    },
    {
      "step": "field-limits",
      "reason": "too-large"
    }
  ],
  "resend": {
    "envelope": "fresh",
    "seq": "new higher",
    "sent_at_ms": "current",
    "item": "same identity and revision",
    "replay_or_stale_before_store": true,
