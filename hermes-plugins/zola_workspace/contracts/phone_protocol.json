  "completeness": [
    "complete",
    "incomplete",
    "exhausted"
  ],
  "rcs_flag": [
    "yes",
    "no",
    "unknown"
  ],
  "sender_kind": [
    "e164",
    "shortcode",
    "alnum",
    "unparsed"
  ],
  "ranking_source": [
    "model",
    "code"
  ],
  "supported_versions": [
    3
  ],
  "listen_port": 47821,
  "reconnecting_grace_ms": 480000,
  "launch_secret_env": "ZOLA_PHONE_LAUNCH_SECRET",
  "pipe_name": "\\\\.\\pipe\\ZolaPhone",
  "check_precedence": [
    {
      "step": "raw-size",
      "reason": "too-large"
    },
    {
      "step": "malformed",
      "reason": "malformed"
    },
    {
      "step": "unsigned",
      "reason": "unsigned"
    },
    {
