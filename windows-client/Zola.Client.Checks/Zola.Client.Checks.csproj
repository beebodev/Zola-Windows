    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Zola.Client.Checks</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Zola.Client\Voice\CaptureLifecycle.cs" Link="Voice\CaptureLifecycle.cs" />
    <Compile Include="..\Zola.Client\Voice\TranscriptAdmission.cs" Link="Voice\TranscriptAdmission.cs" />
  </ItemGroup>
</Project>
