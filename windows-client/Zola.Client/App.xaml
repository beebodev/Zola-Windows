<?xml version="1.0" encoding="utf-8"?>
<!-- P1-CLIENT: WinUI application resources for the process-lifecycle shell — P1-D01 -->
<Application
    x:Class="Zola.Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- P3-SHELL: tokens after WinUI so HUD and dock do not read system theme brushes — P3-D08 -->
                <ResourceDictionary Source="ms-appx:///Themes/ZolaTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
