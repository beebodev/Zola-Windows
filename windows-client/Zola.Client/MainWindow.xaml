<?xml version="1.0" encoding="utf-8"?>
<!-- P1-CLIENT: chat surface over /api/ws; typing stays off until session.create returns — P1-D01 -->
<Window
    x:Class="Zola.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Zola">
    <!-- P2-VOICE: Ctrl+Space starts or stops capture; Window has no accelerator collection, so the root grid owns it — P2-D04 -->
    <Grid Padding="16" RowSpacing="12">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Space" Modifiers="Control" Invoked="OnVoiceHotkey" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- P1-CLIENT: readiness and non-chat socket notes stay outside the transcript — P1-D01 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Zola" Style="{StaticResource TitleTextBlockStyle}" />
                <!-- P2-VOICE: Voice or Text is chosen here; both leave the composer usable — P2-D07 -->
                <Button x:Name="ModeButton" Grid.Column="1" Margin="0,0,8,0" Click="OnModeClick" Content="Voice" IsEnabled="False" />
                <!-- P1-SESSION: the session list stays hidden until this toggle is used — P1-D04 -->
                <Button x:Name="SessionsButton" Grid.Column="2" Click="OnSessionsToggle" Content="Sessions" IsEnabled="False" />
            </Grid>
            <TextBlock x:Name="StatusText" TextWrapping="WrapWholeWords" />
            <TextBlock x:Name="DetailText" TextWrapping="WrapWholeWords" Opacity="0.8" />
            <!-- P2-VOICE: voice state comes from recorder events and the turn, not from a pipeline probe — P2-D08 -->
            <TextBlock x:Name="VoiceStateText" Text="Idle" TextWrapping="WrapWholeWords" />
            <!-- P2-VOICE: this line says what the microphone is doing, separate from the voice state — P2-D08 -->
            <TextBlock x:Name="MicIndicatorText" Text="Mic: off" TextWrapping="WrapWholeWords" />
        </StackPanel>
        <!-- P1-CLIENT: the transcript is the response area message.start prepares and deltas fill — P1-D01 -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="TranscriptScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Transcript" Spacing="8" />
            </ScrollViewer>
            <!-- P1-SESSION: the list sits beside the chat and is collapsed until the toggle opens it — P1-D04 -->
            <Border x:Name="SessionPanel" Grid.Column="1" Width="300" Padding="12" Visibility="Collapsed" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Sessions" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="EmptySessionsText" Text="No saved sessions yet." TextWrapping="WrapWholeWords" Opacity="0.8" />
                        <ListView x:Name="SessionList" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnSessionItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Padding="0,4">
                                        <TextBlock Text="{Binding Id}" TextWrapping="WrapWholeWords" />
                                        <TextBlock Text="{Binding LastActiveText}" Opacity="0.7" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <!-- P1-SESSION: new session uses session.create on a fresh socket and shows the returned id — P1-D04 -->
                        <Button x:Name="NewSessionButton" HorizontalAlignment="Stretch" Click="OnNewSessionClick" Content="New session" IsEnabled="False" />
                        <Button x:Name="CloseSessionsButton" HorizontalAlignment="Stretch" Click="OnCloseSessionsClick" Content="Close" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- P1-CLIENT: Send calls prompt.submit; Cancel calls session.interrupt — P1-D01 -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="Composer"
                Grid.Column="0"
                AcceptsReturn="True"
                IsEnabled="False"
                MaxHeight="120"
                PlaceholderText="Waiting for the session…"
                TextWrapping="Wrap" />
            <!-- P2-VOICE: the mic toggles voice.record; the label shows listening or idle — P2-D04 -->
            <Button x:Name="MicButton" Grid.Column="1" MinWidth="88" VerticalAlignment="Bottom" Click="OnMicClick" Content="Mic" IsEnabled="False" />
            <Button x:Name="SendButton" Grid.Column="2" MinWidth="88" VerticalAlignment="Bottom" Click="OnSendClick" Content="Send" IsEnabled="False" />
            <Button x:Name="CancelButton" Grid.Column="3" MinWidth="88" VerticalAlignment="Bottom" Click="OnCancelClick" Content="Cancel" IsEnabled="False" />
        </Grid>
    </Grid>
</Window>
