<?xml version="1.0" encoding="utf-8"?>
<!-- P3-SHELL: one dictionary for colours, Rajdhani, and geometry — P3-D08 -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ZolaBackground">#080808</Color>
    <Color x:Key="ZolaAmberPrimary">#FFD37A</Color>
    <Color x:Key="ZolaAmberMuted">#8A6A2A</Color>
    <Color x:Key="ZolaAmberDark">#5A4820</Color>
    <Color x:Key="ZolaAlertGlow">#FFE7A5</Color>
    <Color x:Key="ZolaPresenceAmber">#FFD05A</Color>
    <Color x:Key="ZolaTextPrimary">#E8DDD0</Color>
    <Color x:Key="ZolaSurface">#141414</Color>
    <Color x:Key="ZolaError">#D9534F</Color>

    <SolidColorBrush x:Key="ZolaBackgroundBrush" Color="{StaticResource ZolaBackground}" />
    <SolidColorBrush x:Key="ZolaAmberPrimaryBrush" Color="{StaticResource ZolaAmberPrimary}" />
    <SolidColorBrush x:Key="ZolaAmberMutedBrush" Color="{StaticResource ZolaAmberMuted}" />
    <SolidColorBrush x:Key="ZolaAmberDarkBrush" Color="{StaticResource ZolaAmberDark}" />
    <SolidColorBrush x:Key="ZolaAlertGlowBrush" Color="{StaticResource ZolaAlertGlow}" />
    <SolidColorBrush x:Key="ZolaPresenceAmberBrush" Color="{StaticResource ZolaPresenceAmber}" />
    <SolidColorBrush x:Key="ZolaTextPrimaryBrush" Color="{StaticResource ZolaTextPrimary}" />
    <SolidColorBrush x:Key="ZolaSurfaceBrush" Color="{StaticResource ZolaSurface}" />
    <SolidColorBrush x:Key="ZolaErrorBrush" Color="{StaticResource ZolaError}" />
    <SolidColorBrush x:Key="ZolaDividerBrush" Color="{StaticResource ZolaAmberDark}" Opacity="0.5" />
    <SolidColorBrush x:Key="ZolaOverlayBrush" Color="{StaticResource ZolaBackground}" Opacity="0.88" />
    <SolidColorBrush x:Key="ZolaUserBubbleBrush" Color="{StaticResource ZolaAmberPrimary}" Opacity="0.10" />
    <SolidColorBrush x:Key="ZolaAssistantBubbleBrush" Color="{StaticResource ZolaSurface}" />

    <FontFamily x:Key="ZolaFontRegular">ms-appx:///Fonts/rajdhani_regular.ttf#Rajdhani</FontFamily>
    <FontFamily x:Key="ZolaFontSemiBold">ms-appx:///Fonts/rajdhani_semibold.ttf#Rajdhani SemiBold</FontFamily>
    <FontFamily x:Key="ZolaIconFont">Segoe Fluent Icons</FontFamily>

    <x:Double x:Key="ZolaDockButtonSize">48</x:Double>
    <x:Double x:Key="ZolaDockIconSize">24</x:Double>
    <x:Double x:Key="ZolaBubbleMaxWidth">380</x:Double>
    <x:Double x:Key="ConversationOverlayMaxWidth">440</x:Double>
    <x:Double x:Key="ConversationOverlayMaxFraction">0.45</x:Double>
    <x:Double x:Key="SessionsPanelWidth">320</x:Double>
    <x:Double x:Key="HudInset">24</x:Double>
    <Thickness x:Key="ZolaMantraIndent">124,0,0,0</Thickness>
    <x:Double x:Key="ZolaRightHudMaxWidth">400</x:Double>
    <x:Double x:Key="ZolaSpace4">4</x:Double>
    <x:Double x:Key="ZolaSpace8">8</x:Double>
    <x:Double x:Key="ZolaSpace12">12</x:Double>
    <x:Double x:Key="ZolaDividerThickness">0.5</x:Double>
    <x:Double x:Key="ZolaDockSeparatorWidth">0.5</x:Double>
    <x:Double x:Key="ZolaNoticeMaxFraction">0.6</x:Double>
    <x:Double x:Key="ZolaComposerMaxHeight">120</x:Double>
    <x:Double x:Key="ZolaBubblePadding">12</x:Double>
    <x:Double x:Key="ZolaBubbleCornerRadius">8</x:Double>
    <x:Double x:Key="ZolaBubbleBorderThickness">1</x:Double>
    <x:Double x:Key="ZolaWindowWidth">1280</x:Double>
    <x:Double x:Key="ZolaWindowHeight">800</x:Double>
    <x:Double x:Key="ZolaWindowMinWidth">900</x:Double>
    <x:Double x:Key="ZolaWindowMinHeight">640</x:Double>
    <x:Int32 x:Key="ZolaLayerPresence">0</x:Int32>
    <x:Int32 x:Key="ZolaLayerHud">10</x:Int32>
    <x:Int32 x:Key="ZolaLayerNotice">20</x:Int32>
    <x:Int32 x:Key="ZolaLayerDock">30</x:Int32>
    <x:Int32 x:Key="ZolaLayerPanel">40</x:Int32>
    <Thickness x:Key="ZolaHudMargin">24,24,72,96</Thickness>
    <Thickness x:Key="ZolaRightHudPad">0,0,24,0</Thickness>
    <Thickness x:Key="ZolaDockMargin">0,0,0,24</Thickness>
    <Thickness x:Key="ZolaPanelAboveDockMargin">0,0,0,96</Thickness>
    <Thickness x:Key="ZolaNoticeMargin">24,0,24,96</Thickness>
    <Thickness x:Key="ZolaDockHostPadding">8,6</Thickness>
    <Thickness x:Key="ZolaSessionItemPadding">0,4</Thickness>
    <Thickness x:Key="ZolaHeaderBottomMargin">0,0,0,8</Thickness>
    <Thickness x:Key="ZolaComposerTopMargin">0,8,0,0</Thickness>
    <CornerRadius x:Key="ZolaDockCornerRadius">28</CornerRadius>

    <Style x:Key="ZolaWordmarkStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ZolaFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="68" />
        <Setter Property="CharacterSpacing" Value="176" />
        <Setter Property="Foreground" Value="{StaticResource ZolaAmberPrimaryBrush}" />
    </Style>
    <Style x:Key="ZolaTaglineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ZolaFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="214" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource ZolaAmberPrimaryBrush}" />
    </Style>
    <Style x:Key="ZolaMantraStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ZolaFontRegular}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CharacterSpacing" Value="125" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource ZolaAmberPrimaryBrush}" />
    </Style>
    <Style x:Key="ZolaSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ZolaFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="286" />
        <Setter Property="Foreground" Value="{StaticResource ZolaAmberMutedBrush}" />
    </Style>
    <Style x:Key="ZolaRightHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ZolaFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="143" />
        <Setter Property="Foreground" Value="{StaticResource ZolaAmberMutedBrush}" />
    </Style>
    <Style x:Key="ZolaRightValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ZolaFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="CharacterSpacing" Value="100" />
        <Setter Property="Foreground" Value="{StaticResource ZolaAmberPrimaryBrush}" />
    </Style>
    <Style x:Key="ZolaTimeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ZolaFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource ZolaAmberPrimaryBrush}" />
    </Style>
    <Style x:Key="ZolaFooterStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ZolaFontRegular}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource ZolaAmberPrimaryBrush}" />
    </Style>
    <Style x:Key="ZolaBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ZolaFontRegular}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource ZolaTextPrimaryBrush}" />
    </Style>
    <Style x:Key="ZolaBubbleHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ZolaFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource ZolaAmberPrimaryBrush}" />
    </Style>
    <Style x:Key="ZolaNoticeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ZolaFontRegular}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource ZolaAmberPrimaryBrush}" />
    </Style>
    <Style x:Key="ZolaDockLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ZolaFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="143" />
        <Setter Property="Foreground" Value="{StaticResource ZolaAmberPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ZolaDockButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ZolaAmberPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="{StaticResource ZolaDockButtonSize}" />
        <Setter Property="MinWidth" Value="{StaticResource ZolaDockButtonSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ZolaAmberMutedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ZolaAmberMutedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZolaPanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ZolaOverlayBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ZolaAmberDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="ZolaDockHostStyle" TargetType="Border" BasedOn="{StaticResource ZolaPanelBorderStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource ZolaDockCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource ZolaDockHostPadding}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="{StaticResource ZolaDockMargin}" />
    </Style>

    <Style x:Key="ZolaComposerStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource ZolaFontRegular}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource ZolaTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource ZolaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ZolaAmberDarkBrush}" />
        <Setter Property="RequestedTheme" Value="Dark" />
        <Setter Property="MaxHeight" Value="{StaticResource ZolaComposerMaxHeight}" />
    </Style>

    <Style x:Key="ZolaTextButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource ZolaFontSemiBold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource ZolaAmberPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource ZolaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ZolaAmberDarkBrush}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
</ResourceDictionary>
